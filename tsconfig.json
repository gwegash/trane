{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,

    "useDefineForClassFields": true,
    "strict": false
  },
  // Worklets are plain .js and run in a different global scope, so they stay out.
  "include": ["ui/**/*.ts"]
}
